# DB Agent (Node) — copy to .env and adjust as needed.

PORT=3001

# Any OpenAI-compatible endpoint works — OpenAI, Groq, Ollama, LM Studio, etc.
LLM_BASE_URL=http://localhost:11434/v1
LLM_API_KEY=ollama
LLM_MODEL=qwen2.5-coder:0.5b
# LLM_MAX_TOKENS=1024            # cap per LLM call; stops runaway generation by small models

# ── SQL engine ───────────────────────────────────────────────────────────────
# Default: Databricks SQL warehouse (Unity Catalog). Fill in your workspace
# host, warehouse HTTP path, and a token with CAN USE + SELECT on the schema.
# Optional engines: sqlite | minio-duckdb | postgres (see below).
SQL_ENGINE=databricks-sql
DATABRICKS_HOST=dbc-xxxx.cloud.databricks.com
DATABRICKS_HTTP_PATH=/sql/1.0/warehouses/xxxxxxxx
DATABRICKS_TOKEN=dapi...
DATABRICKS_CATALOG=samples
DATABRICKS_SCHEMA=tpcds_sf1
# DATABRICKS_MAX_ROWS=1000   # cap on rows returned to the UI
# Cost guard: EXPLAIN COST runs before every query. Under both limits it
# auto-runs; above either, or if no estimate, the UI asks for approval.
# COST_ANALYSIS=auto             # auto = only queries that may return many rows; always = every query
# ANALYZE_SKIP_LIMIT=1000        # a top-level LIMIT up to this counts as bounded
# APPROVAL_MAX_BYTES=104857600   # 100 MB, 0 disables
# APPROVAL_MAX_ROWS=100000       # 0 disables
# APPROVAL_MAX_COST_USD=0.25     # est. compute $ (high end of range), 0 disables
# APPROVAL_ALWAYS=false          # true = ask for every query

# SQL_ENGINE=sqlite — local file (optional offline path).
# DB_PATH=./data/demo.db

# SQL_ENGINE=minio-duckdb — Parquet objects in MinIO/any S3-compatible store.
# MINIO_ENDPOINT=localhost:9000
# MINIO_BUCKET=demo-bucket
# MINIO_PREFIX=db-agent-demo
# MINIO_ACCESS_KEY=minioadmin
# MINIO_SECRET_KEY=minioadmin
# MINIO_USE_SSL=false
# MINIO_REGION=us-east-1

# SQL_ENGINE=postgres — any standard Postgres (covers Databricks Lakebase).
# DB_URL=postgresql://user:password@host:5432/dbname?sslmode=require
# PG_HOST=host
# PG_PORT=5432
# PG_DATABASE=dbname
# PG_USER=user
# PG_PASSWORD=password
# PG_SSL=default
# PG_SCHEMA=public
# PG_MAX_ROWS=1000               # rows returned to the UI (export streams everything)
# PG_LARGE_TABLE_ROWS=100000     # seq scans on tables at least this big are flagged

# ── Cross-platform contextual memory ────────────────────────────────────────
DBAGENT_ID=local

MEMORY_ENABLED=true
MEMORY_DB_KIND=sqlite
MEMORY_TTL_SECONDS=604800

# MEMORY_BACKEND=local (default) or s3vectors / pgvector / milvus — see README.
# MEMORY_STORE_PATH=./data/memory_store.jsonl

# Embeddings default to LLM_BASE_URL/LLM_API_KEY when EMBEDDING_* are unset.
#   ollama pull nomic-embed-text   # recommended when using local Ollama
EMBEDDING_MODEL=nomic-embed-text
