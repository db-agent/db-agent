# Copy to groq.env (git-ignored), put your key in, and launch with:
#   docker compose --env-file .env --env-file groq.env -f docker-compose.bakehouse.yml up -d --force-recreate agent-curated
# To go back to the local 7B model, relaunch without groq.env:
#   docker compose -f docker-compose.bakehouse.yml up -d --force-recreate agent-curated
DEMO_LLM_BASE_URL=https://api.groq.com/openai/v1
DEMO_LLM_API_KEY=paste-your-groq-key-here
DEMO_LLM_MODEL=openai/gpt-oss-120b
DEMO_LLM_MAX_TOKENS=4096
DEMO_LLM_REASONING_EFFORT=low
DEMO_LLM_MAX_RETRIES=8
