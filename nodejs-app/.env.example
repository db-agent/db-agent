# DB Agent (Node) — copy to .env and adjust as needed.

PORT=3001
# Default (unset) uses the self-contained ./data/demo.db bundled in this
# directory. Override to ../data/demo.db to instead share the root Python
# app's seeded DB during local dev.
# DB_PATH=../data/demo.db

# Any OpenAI-compatible endpoint works — OpenAI, Groq, Ollama, LM Studio, etc.
LLM_BASE_URL=http://localhost:11434/v1
LLM_API_KEY=ollama
LLM_MODEL=qwen2.5-coder:7b

# ── Cross-platform contextual memory ────────────────────────────────────────
# Unique per running instance — tags writes, excludes self on reads.
DBAGENT_ID=local

MEMORY_ENABLED=true
MEMORY_DB_KIND=sqlite
MEMORY_TTL_SECONDS=604800
# MEMORY_STORE_PATH=./data/memory_store.jsonl   # default shown

# Must be served by LLM_BASE_URL. Default assumes an OpenAI-compatible
# embeddings endpoint — override for Ollama, e.g.:
#   ollama pull nomic-embed-text
#   EMBEDDING_MODEL=nomic-embed-text
EMBEDDING_MODEL=text-embedding-3-small
