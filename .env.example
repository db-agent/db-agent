# ── Database ──────────────────────────────────────────────────────────────────
# SQLite (default — no server required)
DB_URL=sqlite:///./data/demo.db

# PostgreSQL example:
# DB_URL=postgresql://user:password@localhost:5432/mydb

# MySQL example:
# DB_URL=mysql+pymysql://user:password@localhost:3306/mydb

# ── LLM ──────────────────────────────────────────────────────────────────────
# OpenAI
LLM_BASE_URL=https://models.github.ai/inference
LLM_API_KEY=
LLM_MODEL=xai/grok-3-mini
# Ollama (local, no key required)
# LLM_BASE_URL=http://localhost:11434/v1
# LLM_API_KEY=ollama
# LLM_MODEL=llama3.2

# Groq
# LLM_BASE_URL=https://api.groq.com/openai/v1
# LLM_API_KEY=gsk_...
# LLM_MODEL=llama-3.1-8b-instant

# ── Cross-platform contextual memory ────────────────────────────────────────
# Unique per running instance — tags writes, excludes self on reads.
DBAGENT_ID=local

MEMORY_ENABLED=true
# local     — JSONL file on disk (data/memory_store.jsonl), no cloud setup.
# s3vectors — Amazon S3 Vectors (preview). Requires MEMORY_S3_BUCKET +
#             MEMORY_ORG_ID (used as the vector index name) + a
#             pre-provisioned vector bucket/index.
MEMORY_BACKEND=local
# MEMORY_S3_BUCKET=dbagent-memory
# MEMORY_S3_REGION=us-east-1
# MEMORY_ORG_ID=demo-org
# MEMORY_TTL_SECONDS=604800

# Must be served by LLM_BASE_URL. Default assumes an OpenAI-compatible
# embeddings endpoint — override for Ollama, e.g.:
#   ollama pull nomic-embed-text
#   EMBEDDING_MODEL=nomic-embed-text
EMBEDDING_MODEL=text-embedding-3-small
